# Copy to slurm/carc.env and fill in. Read by slurm/submit.sh and the job scripts.
ACCOUNT=<pi>_123                 # from `myaccount` on discovery.usc.edu
PARTITION=gpu
GPU=a100                         # or a40 / l40s / v100; `sinfo -p gpu -o "%G"` lists what exists
PROJ=/scratch1/$USER/forkcache   # repo checkout on CARC
export HF_HOME=/scratch1/$USER/hf
MODEL=Qwen/Qwen2.5-7B-Instruct
PORT=30000
