# slurm/carc.env — written by slurm/run_all.sh on first run (auto-detected); edit if needed.
ACCOUNT=<pi>_123                 # `myaccount` on discovery.usc.edu
PARTITION=gpu
CPU_PARTITION=main               # for the final publish job
GPU=a100                         # a100 / a40 / l40s / v100; `sinfo -p gpu -o "%G"` lists them
PROJ=/scratch1/$USER/forkcache   # this repo's checkout on CARC
PRIVATE=$PROJ/private            # clone of the private data repo (traces in, results out)
ZAGE_DIR=/scratch2/$USER/Colarado_river_project_w_logs/Collorado-River-Project_final
export HF_HOME=/scratch1/$USER/hf
MODEL=Qwen/Qwen2.5-7B-Instruct
PORT=30000
PRESSURE_TOKENS=20000            # KV pool cap (tokens) for the under-pressure runs (~1.1 GB at 7B)
